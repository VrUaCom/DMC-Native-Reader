<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Legacy read access covers file:// opens from older file managers on
      API 29 and below.  Scoped storage makes it useless from API 30 on.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
      SCM/MOD are ordinary non-media files, so MediaStore cannot see them and
      READ_MEDIA_* does not apply.  All-files access is the only permission
      that lets the built-in browser scan storage for them directly.  It is
      requested at runtime and is optional: the browser also works through a
      user-picked SAF tree, which needs no permission at all.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="false"
        android:label="DMC Native Reader v8"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.dmcrengine.nativeviewer.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Built-in DMC browser.  Not exported: it is the in-app fallback for
          devices whose file manager refuses to route .scm / .mod at all.
        -->
        <activity
            android:name="com.dmcrengine.nativeviewer.DmcBrowserActivity"
            android:exported="false"
            android:label="Browse DMC files" />

        <!--
          Real exported component for OEM file managers.  Do not replace this
          with an activity-alias: v7 intentionally tests a concrete Activity
          because Samsung My Files may apply its own custom-file routing before
          the stock Android chooser.
        -->
        <activity
            android:name="com.dmcrengine.nativeviewer.DmcOpenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="DMC Native Reader v8">

            <!-- Canonical DMC MIME types. -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="application/vnd.dmc.scm" />
                <data android:mimeType="application/vnd.dmc.mod" />
            </intent-filter>

            <!-- MIME values observed/commonly associated with unknown SCM/MOD files. -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-mod" />
                <data android:mimeType="application/x-scm" />
                <data android:mimeType="application/mod" />
                <data android:mimeType="application/scm" />
                <data android:mimeType="audio/mod" />
                <data android:mimeType="audio/x-mod" />
                <data android:mimeType="video/mpeg" />
                <data android:mimeType="video/x-mod" />
            </intent-filter>

            <!-- Generic typed provider fallback. Native probing remains fail-closed. -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- Untyped provider fallbacks. -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:scheme="content" />
            </intent-filter>

            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:scheme="file" />
            </intent-filter>

            <!--
              Extension-specific routes. Android pathPattern is a simple glob,
              not a regular expression, so several dotted-path forms are listed.
              The host is required for pathPattern matching.
            -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.mod" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\..*\\.mod" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\..*\\..*\\.mod" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.MOD" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.scm" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\..*\\.scm" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\..*\\..*\\.scm" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.SCM" />
            </intent-filter>

            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.mod" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\..*\\.mod" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\..*\\..*\\.mod" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.MOD" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.scm" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\..*\\.scm" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\..*\\..*\\.scm" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.SCM" />
            </intent-filter>

            <!--
              API 31+ suffix matching.  Unlike pathPattern this matches the
              decoded path, so it still fires for SAF document URIs whose path
              carries an encoded ':' or '/' (primary%3ADownload%2Ffile.mod).
            -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:scheme="content" android:host="*" android:pathSuffix=".mod" />
                <data android:scheme="content" android:host="*" android:pathSuffix=".MOD" />
                <data android:scheme="content" android:host="*" android:pathSuffix=".scm" />
                <data android:scheme="content" android:host="*" android:pathSuffix=".SCM" />
                <data android:scheme="file" android:host="*" android:pathSuffix=".mod" />
                <data android:scheme="file" android:host="*" android:pathSuffix=".MOD" />
                <data android:scheme="file" android:host="*" android:pathSuffix=".scm" />
                <data android:scheme="file" android:host="*" android:pathSuffix=".SCM" />
            </intent-filter>

            <intent-filter android:priority="100">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
