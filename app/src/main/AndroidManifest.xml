<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:label="DMC Native Reader"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.dmcrengine.nativeviewer.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.dmcrengine.nativeviewer.DmcOpenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="DMC Native Reader">

            <!-- Native Reader v33 explicit public format surface. -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="application/vnd.dmc.scm" />
                <data android:mimeType="application/vnd.dmc.mod" />
                <data android:mimeType="application/vnd.dmc.ptx" />
                <data android:mimeType="image/vnd-ms.dds" />
                <data android:mimeType="application/vnd.dmc.eventtbl" />
                <data android:mimeType="application/vnd.dmc.pac" />
                <data android:mimeType="application/vnd.dmc.mot" />
            </intent-filter>

            <!-- Samsung/OEM extension routing for the five promoted families.
                 EventTbl keeps its stock EventTblNN.bin naming. We deliberately
                 do not claim generic .bin files; native probing still requires
                 the confirmed EVT\0 content identity before accepting them. -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.scm" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.mod" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.dds" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.ptx" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.pac" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.mot" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*EventTbl.*\\.bin" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*eventtbl.*\\.bin" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.SCM" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.MOD" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.DDS" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.PTX" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.PAC" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.MOT" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*EVENTTBL.*\\.BIN" />
            </intent-filter>

            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.scm" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.mod" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.dds" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ptx" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.pac" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.mot" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*EventTbl.*\\.bin" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*eventtbl.*\\.bin" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.SCM" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.MOD" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.DDS" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.PTX" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.PAC" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.MOT" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*EVENTTBL.*\\.BIN" />
            </intent-filter>

            <!-- Provider fallback stays generic; native probing still fails closed. -->
            <intent-filter android:priority="50">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter android:priority="50">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
